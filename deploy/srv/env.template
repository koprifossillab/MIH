# /srv/MIH/.env 로 두는 것. 이 파일은 저장소에 두는 본이고, 실제 값은 장비에만 둔다.

# 운영 비밀키. 비워 두면 entrypoint 가 /srv/MIH/state/secret_key 에 만들어 쓴다.
MIH_SECRET_KEY=

# 들어오는 호스트. nginx 뒤에 있으므로 이 장비가 불리는 이름을 모두 적는다.
MIH_ALLOWED_HOSTS=127.0.0.1,localhost,paleolab,paleo-server,172.16.116.98

# 화면에서 명칭(퇴적 환경 이름)을 고칠 때 묻는 낱말. 쉼표로 여럿. 비워 두면 운영에서는 고치기가 닫힌다.
# 고친 이름은 /srv/MIH/state/labels.json 에 쌓인다(백업 대상).
MIH_EDITOR_KEY=

# 명칭 고치기가 POST 라 CSRF 를 검사한다. 80 이 아닌 포트로 들어오면 원본 주소를 적는다
# (예: http://172.16.116.98:8082).
MIH_CSRF_TRUSTED_ORIGINS=
